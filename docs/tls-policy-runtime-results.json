  "certificate_contract": [
    "Native verification precedes the callback; the callback receives owned peer/verified DER chains, hostname, original result/status, public-root status, OCSP and SCT data",
    "UseDefault preserves native verification; Reject fails; Accept overrides certificate errors only and never promotes private trust to public-root trust",
    "Completion can run on another thread; drop/panic rejects; cancellation/reset/deadline/shutdown release native work and late completion is harmless",
    "Completed tokens are not marked canceled; a held completion does not retain the client callback after shutdown",
    "Canceling one HTTP request preserves another active TLS verification"
  ],
  "ech_contract": [
    "Static ECHConfigList and host-resolver HTTPS discovery succeed on direct TLS/H1/H2/H3/WSS and Naive HTTPS/QUIC",
    "Client metadata and server ECHAccepted confirm successful encryption and application traffic",
    "Authenticated retry verifies the public name and then the inner name",
    "Strict rejects a server without ECH even if the certificate callback accepts; Opportunistic and Disabled retain their explicit policies",
    "Direct host rules use actual destination ports for DNS, normalize trailing dots, and follow the new host on redirects",
    "Explicit direct ECH rules or a certificate callback disable cross-host H2/H3 coalescing while preserving same-host reuse"
  ],
  "reproduced_fixes": [
    {
      "problem": "A canceled HTTP request could leave a speculative TLS job waiting indefinitely for its host certificate decision",
      "fix": "When all direct operations are gone, abort pending host work; do not abort while another TLS/HTTP/WS operation is alive"
    },
    {
      "problem": "A trailing dot in the configured ECH hostname caused the undotted target to miss the rule and connect without ECH",
      "fix": "Normalize configured and matched DNS names, including the trailing dot"
    }
  ],
